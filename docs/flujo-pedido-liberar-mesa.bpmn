<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions_LaPreviaPedido"
    targetNamespace="https://laprevia-restobar/bpmn">

    <bpmn:collaboration id="Collaboration_LaPrevia">
        <bpmn:participant id="Participant_LaPrevia" name="La Previa Restobar" processRef="Process_PedidoLiberarMesa"/>
    </bpmn:collaboration>

    <bpmn:process id="Process_PedidoLiberarMesa" name="Pedido del cliente hasta liberar mesa" isExecutable="false">
        <bpmn:laneSet id="LaneSet_LaPrevia">
            <bpmn:lane id="Lane_Cliente" name="Cliente">
                <bpmn:flowNodeRef>StartEvent_ClienteSolicitaPedido</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_RevisarCarta</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_ElegirOtroProducto</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_AgregarMasProductos</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_SolicitarCuenta</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_MesaLiberada</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_PedidoCancelado</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Mesero" name="Mesero">
                <bpmn:flowNodeRef>Task_TomarPedido</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_InformarSinStock</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_PedidoCancelado</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_EntregarPedido</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_AgregarProductos</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_CobrarMovil</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Cocina" name="Cocina / Chef">
                <bpmn:flowNodeRef>Task_RecibirPedido</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_AceptarPedido</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_PrepararPedido</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_MarcarListo</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Caja" name="Caja / App de escritorio">
                <bpmn:flowNodeRef>Gateway_DondeCobra</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_BuscarPedidoMesa</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_CobrarEscritorio</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Sistema" name="Sistema La Previa">
                <bpmn:flowNodeRef>Task_ValidarStockMesa</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_HayStock</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_RegistrarPedidoOcuparMesa</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_CambiarPedidoCancelado</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_LiberarMesaCancelacion</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_RegistrarMetodoPago</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_GenerarTicket</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_LiberarMesa</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_Firebase" name="Firebase / Base de datos">
                <bpmn:flowNodeRef>Task_GuardarPedidoMesa</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_GuardarCancelacion</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_GuardarMesaLibreCancelacion</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_ActualizarPedidoCobrado</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_GuardarMesaLibre</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>

        <bpmn:startEvent id="StartEvent_ClienteSolicitaPedido" name="Cliente solicita pedido">
            <bpmn:outgoing>Flow_01</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:task id="Task_RevisarCarta" name="Revisar carta QR o pedir al mesero">
            <bpmn:incoming>Flow_01</bpmn:incoming>
            <bpmn:outgoing>Flow_02</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_TomarPedido" name="Tomar pedido en la app movil">
            <bpmn:incoming>Flow_02</bpmn:incoming>
            <bpmn:incoming>Flow_06B</bpmn:incoming>
            <bpmn:incoming>Flow_19A</bpmn:incoming>
            <bpmn:outgoing>Flow_03</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_ValidarStockMesa" name="Validar productos y mesa">
            <bpmn:incoming>Flow_03</bpmn:incoming>
            <bpmn:outgoing>Flow_04</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_HayStock" name="Hay stock disponible?">
            <bpmn:incoming>Flow_04</bpmn:incoming>
            <bpmn:outgoing>Flow_05A</bpmn:outgoing>
            <bpmn:outgoing>Flow_05B</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_InformarSinStock" name="Informar producto no disponible">
            <bpmn:incoming>Flow_05A</bpmn:incoming>
            <bpmn:outgoing>Flow_06A</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_ElegirOtroProducto" name="Elegir otro producto">
            <bpmn:incoming>Flow_06A</bpmn:incoming>
            <bpmn:outgoing>Flow_06B</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_RegistrarPedidoOcuparMesa" name="Registrar pedido y ocupar mesa">
            <bpmn:incoming>Flow_05B</bpmn:incoming>
            <bpmn:outgoing>Flow_07</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_GuardarPedidoMesa" name="Guardar pedido y estado de mesa">
            <bpmn:incoming>Flow_07</bpmn:incoming>
            <bpmn:outgoing>Flow_08</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_PedidoCancelado" name="Pedido cancelado?">
            <bpmn:incoming>Flow_08</bpmn:incoming>
            <bpmn:outgoing>Flow_09A</bpmn:outgoing>
            <bpmn:outgoing>Flow_09B</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_CambiarPedidoCancelado" name="Cambiar pedido a cancelado">
            <bpmn:incoming>Flow_09A</bpmn:incoming>
            <bpmn:outgoing>Flow_10A</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_GuardarCancelacion" name="Guardar cancelacion">
            <bpmn:incoming>Flow_10A</bpmn:incoming>
            <bpmn:outgoing>Flow_11A</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_LiberarMesaCancelacion" name="Liberar mesa por cancelacion">
            <bpmn:incoming>Flow_11A</bpmn:incoming>
            <bpmn:outgoing>Flow_12A</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_GuardarMesaLibreCancelacion" name="Guardar mesa como libre">
            <bpmn:incoming>Flow_12A</bpmn:incoming>
            <bpmn:outgoing>Flow_13A</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="EndEvent_PedidoCancelado" name="Pedido cancelado y mesa libre">
            <bpmn:incoming>Flow_13A</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:task id="Task_RecibirPedido" name="Recibir pedido">
            <bpmn:incoming>Flow_09B</bpmn:incoming>
            <bpmn:outgoing>Flow_10</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_AceptarPedido" name="Aceptar pedido">
            <bpmn:incoming>Flow_10</bpmn:incoming>
            <bpmn:outgoing>Flow_11</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_PrepararPedido" name="Preparar pedido">
            <bpmn:incoming>Flow_11</bpmn:incoming>
            <bpmn:outgoing>Flow_12</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_MarcarListo" name="Marcar pedido como listo">
            <bpmn:incoming>Flow_12</bpmn:incoming>
            <bpmn:outgoing>Flow_13</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_EntregarPedido" name="Entregar pedido al cliente">
            <bpmn:incoming>Flow_13</bpmn:incoming>
            <bpmn:outgoing>Flow_14</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_AgregarMasProductos" name="Desea agregar mas productos?">
            <bpmn:incoming>Flow_14</bpmn:incoming>
            <bpmn:outgoing>Flow_15A</bpmn:outgoing>
            <bpmn:outgoing>Flow_15B</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_AgregarProductos" name="Agregar productos al pedido">
            <bpmn:incoming>Flow_15A</bpmn:incoming>
            <bpmn:outgoing>Flow_19A</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_SolicitarCuenta" name="Solicitar cuenta">
            <bpmn:incoming>Flow_15B</bpmn:incoming>
            <bpmn:outgoing>Flow_16</bpmn:outgoing>
        </bpmn:task>
        <bpmn:exclusiveGateway id="Gateway_DondeCobra" name="Donde se realiza el cobro?">
            <bpmn:incoming>Flow_16</bpmn:incoming>
            <bpmn:outgoing>Flow_17A</bpmn:outgoing>
            <bpmn:outgoing>Flow_17B</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:task id="Task_CobrarMovil" name="Cobrar desde app movil">
            <bpmn:incoming>Flow_17A</bpmn:incoming>
            <bpmn:outgoing>Flow_18A</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_BuscarPedidoMesa" name="Buscar pedido o mesa">
            <bpmn:incoming>Flow_17B</bpmn:incoming>
            <bpmn:outgoing>Flow_18B</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_CobrarEscritorio" name="Cobrar desde app de escritorio">
            <bpmn:incoming>Flow_18B</bpmn:incoming>
            <bpmn:outgoing>Flow_19B</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_RegistrarMetodoPago" name="Registrar metodo de pago">
            <bpmn:incoming>Flow_18A</bpmn:incoming>
            <bpmn:incoming>Flow_19B</bpmn:incoming>
            <bpmn:outgoing>Flow_20</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_GenerarTicket" name="Generar ticket">
            <bpmn:incoming>Flow_20</bpmn:incoming>
            <bpmn:outgoing>Flow_21</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_ActualizarPedidoCobrado" name="Actualizar pedido como cobrado">
            <bpmn:incoming>Flow_21</bpmn:incoming>
            <bpmn:outgoing>Flow_22</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_LiberarMesa" name="Liberar mesa">
            <bpmn:incoming>Flow_22</bpmn:incoming>
            <bpmn:outgoing>Flow_23</bpmn:outgoing>
        </bpmn:task>
        <bpmn:task id="Task_GuardarMesaLibre" name="Guardar mesa como libre">
            <bpmn:incoming>Flow_23</bpmn:incoming>
            <bpmn:outgoing>Flow_24</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="EndEvent_MesaLiberada" name="Mesa liberada y venta registrada">
            <bpmn:incoming>Flow_24</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ClienteSolicitaPedido" targetRef="Task_RevisarCarta"/>
        <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RevisarCarta" targetRef="Task_TomarPedido"/>
        <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_TomarPedido" targetRef="Task_ValidarStockMesa"/>
        <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_ValidarStockMesa" targetRef="Gateway_HayStock"/>
        <bpmn:sequenceFlow id="Flow_05A" name="No" sourceRef="Gateway_HayStock" targetRef="Task_InformarSinStock"/>
        <bpmn:sequenceFlow id="Flow_05B" name="Si" sourceRef="Gateway_HayStock" targetRef="Task_RegistrarPedidoOcuparMesa"/>
        <bpmn:sequenceFlow id="Flow_06A" sourceRef="Task_InformarSinStock" targetRef="Task_ElegirOtroProducto"/>
        <bpmn:sequenceFlow id="Flow_06B" sourceRef="Task_ElegirOtroProducto" targetRef="Task_TomarPedido"/>
        <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_RegistrarPedidoOcuparMesa" targetRef="Task_GuardarPedidoMesa"/>
        <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_GuardarPedidoMesa" targetRef="Gateway_PedidoCancelado"/>
        <bpmn:sequenceFlow id="Flow_09A" name="Si" sourceRef="Gateway_PedidoCancelado" targetRef="Task_CambiarPedidoCancelado"/>
        <bpmn:sequenceFlow id="Flow_09B" name="No" sourceRef="Gateway_PedidoCancelado" targetRef="Task_RecibirPedido"/>
        <bpmn:sequenceFlow id="Flow_10A" sourceRef="Task_CambiarPedidoCancelado" targetRef="Task_GuardarCancelacion"/>
        <bpmn:sequenceFlow id="Flow_11A" sourceRef="Task_GuardarCancelacion" targetRef="Task_LiberarMesaCancelacion"/>
        <bpmn:sequenceFlow id="Flow_12A" sourceRef="Task_LiberarMesaCancelacion" targetRef="Task_GuardarMesaLibreCancelacion"/>
        <bpmn:sequenceFlow id="Flow_13A" sourceRef="Task_GuardarMesaLibreCancelacion" targetRef="EndEvent_PedidoCancelado"/>
        <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RecibirPedido" targetRef="Task_AceptarPedido"/>
        <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_AceptarPedido" targetRef="Task_PrepararPedido"/>
        <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_PrepararPedido" targetRef="Task_MarcarListo"/>
        <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_MarcarListo" targetRef="Task_EntregarPedido"/>
        <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_EntregarPedido" targetRef="Gateway_AgregarMasProductos"/>
        <bpmn:sequenceFlow id="Flow_15A" name="Si" sourceRef="Gateway_AgregarMasProductos" targetRef="Task_AgregarProductos"/>
        <bpmn:sequenceFlow id="Flow_15B" name="No" sourceRef="Gateway_AgregarMasProductos" targetRef="Task_SolicitarCuenta"/>
        <bpmn:sequenceFlow id="Flow_19A" sourceRef="Task_AgregarProductos" targetRef="Task_TomarPedido"/>
        <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_SolicitarCuenta" targetRef="Gateway_DondeCobra"/>
        <bpmn:sequenceFlow id="Flow_17A" name="Mesero" sourceRef="Gateway_DondeCobra" targetRef="Task_CobrarMovil"/>
        <bpmn:sequenceFlow id="Flow_17B" name="Caja" sourceRef="Gateway_DondeCobra" targetRef="Task_BuscarPedidoMesa"/>
        <bpmn:sequenceFlow id="Flow_18A" sourceRef="Task_CobrarMovil" targetRef="Task_RegistrarMetodoPago"/>
        <bpmn:sequenceFlow id="Flow_18B" sourceRef="Task_BuscarPedidoMesa" targetRef="Task_CobrarEscritorio"/>
        <bpmn:sequenceFlow id="Flow_19B" sourceRef="Task_CobrarEscritorio" targetRef="Task_RegistrarMetodoPago"/>
        <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_RegistrarMetodoPago" targetRef="Task_GenerarTicket"/>
        <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_GenerarTicket" targetRef="Task_ActualizarPedidoCobrado"/>
        <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_ActualizarPedidoCobrado" targetRef="Task_LiberarMesa"/>
        <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_LiberarMesa" targetRef="Task_GuardarMesaLibre"/>
        <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_GuardarMesaLibre" targetRef="EndEvent_MesaLiberada"/>
    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_LaPrevia">
        <bpmndi:BPMNPlane id="BPMNPlane_LaPrevia" bpmnElement="Collaboration_LaPrevia">
            <bpmndi:BPMNShape id="Participant_LaPrevia_di" bpmnElement="Participant_LaPrevia" isHorizontal="true">
                <dc:Bounds x="40" y="40" width="2850" height="960"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_Cliente_di" bpmnElement="Lane_Cliente" isHorizontal="true">
                <dc:Bounds x="70" y="40" width="2820" height="160"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_Mesero_di" bpmnElement="Lane_Mesero" isHorizontal="true">
                <dc:Bounds x="70" y="200" width="2820" height="160"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_Cocina_di" bpmnElement="Lane_Cocina" isHorizontal="true">
                <dc:Bounds x="70" y="360" width="2820" height="160"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_Caja_di" bpmnElement="Lane_Caja" isHorizontal="true">
                <dc:Bounds x="70" y="520" width="2820" height="160"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_Sistema_di" bpmnElement="Lane_Sistema" isHorizontal="true">
                <dc:Bounds x="70" y="680" width="2820" height="160"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_Firebase_di" bpmnElement="Lane_Firebase" isHorizontal="true">
                <dc:Bounds x="70" y="840" width="2820" height="160"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="StartEvent_ClienteSolicitaPedido_di" bpmnElement="StartEvent_ClienteSolicitaPedido">
                <dc:Bounds x="130" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_RevisarCarta_di" bpmnElement="Task_RevisarCarta">
                <dc:Bounds x="220" y="80" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_TomarPedido_di" bpmnElement="Task_TomarPedido">
                <dc:Bounds x="420" y="240" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_ValidarStockMesa_di" bpmnElement="Task_ValidarStockMesa">
                <dc:Bounds x="610" y="720" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Gateway_HayStock_di" bpmnElement="Gateway_HayStock" isMarkerVisible="true">
                <dc:Bounds x="805" y="735" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_InformarSinStock_di" bpmnElement="Task_InformarSinStock">
                <dc:Bounds x="910" y="240" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_ElegirOtroProducto_di" bpmnElement="Task_ElegirOtroProducto">
                <dc:Bounds x="910" y="80" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_RegistrarPedidoOcuparMesa_di" bpmnElement="Task_RegistrarPedidoOcuparMesa">
                <dc:Bounds x="930" y="720" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_GuardarPedidoMesa_di" bpmnElement="Task_GuardarPedidoMesa">
                <dc:Bounds x="1130" y="880" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Gateway_PedidoCancelado_di" bpmnElement="Gateway_PedidoCancelado" isMarkerVisible="true">
                <dc:Bounds x="1325" y="255" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_CambiarPedidoCancelado_di" bpmnElement="Task_CambiarPedidoCancelado">
                <dc:Bounds x="1430" y="720" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_GuardarCancelacion_di" bpmnElement="Task_GuardarCancelacion">
                <dc:Bounds x="1620" y="880" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_LiberarMesaCancelacion_di" bpmnElement="Task_LiberarMesaCancelacion">
                <dc:Bounds x="1810" y="720" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_GuardarMesaLibreCancelacion_di" bpmnElement="Task_GuardarMesaLibreCancelacion">
                <dc:Bounds x="2000" y="880" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="EndEvent_PedidoCancelado_di" bpmnElement="EndEvent_PedidoCancelado">
                <dc:Bounds x="2200" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="Task_RecibirPedido_di" bpmnElement="Task_RecibirPedido">
                <dc:Bounds x="1430" y="400" width="130" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_AceptarPedido_di" bpmnElement="Task_AceptarPedido">
                <dc:Bounds x="1610" y="400" width="130" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_PrepararPedido_di" bpmnElement="Task_PrepararPedido">
                <dc:Bounds x="1790" y="400" width="130" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_MarcarListo_di" bpmnElement="Task_MarcarListo">
                <dc:Bounds x="1970" y="400" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_EntregarPedido_di" bpmnElement="Task_EntregarPedido">
                <dc:Bounds x="2160" y="240" width="140" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Gateway_AgregarMasProductos_di" bpmnElement="Gateway_AgregarMasProductos" isMarkerVisible="true">
                <dc:Bounds x="2365" y="95" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_AgregarProductos_di" bpmnElement="Task_AgregarProductos">
                <dc:Bounds x="2480" y="240" width="140" height="80"/>
